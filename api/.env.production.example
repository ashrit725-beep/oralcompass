# OralCompass production environment (single container: api/app/server.py). Copy into the platform's variables UI.
# Secrets are listed WITHOUT values: generate or paste them in the platform, never commit them, never put them in the web bundle.
# The Dockerfile already sets the four "image defaults" below; set them only to override.

# ---- runtime mode ----
# image default. Refuses to start with dev auth on or a missing/short session secret.
ORALCOMPASS_ENV=production
# ORALCOMPASS_DEV_AUTH must NOT be set in production (it trusts an X-Dev-User header).
ORALCOMPASS_LOG_LEVEL=INFO

# ---- sessions (api/app/sessions.py) ----
# Required secret: a random value of at least 32 characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Rotating it ends every visitor's session (their records stay in the database but are no longer reachable).
ORALCOMPASS_SESSION_SECRET=

# ---- storage (persistent volume mounted at /data) ----
# image default
ORALCOMPASS_STORE=sqlite
# image default
ORALCOMPASS_DB_PATH=/data/oralcompass.db
# image default (uploaded PDFs, one directory per hashed session)
ORALCOMPASS_DATA_DIR=/data/uploads

# ---- live AI (OpenRouter → Claude Haiku 4.5); leave the key empty for demo mode ----
# "none" forces demo mode even when a key is present
ORALCOMPASS_LLM_PROVIDER=openrouter
ORALCOMPASS_LLM_MODEL=anthropic/claude-haiku-4.5
# Required secret for live mode. Lives only in server env; never logged, never returned by /api/health.
OPENROUTER_API_KEY=

# ---- live-AI cost guard (api/app/llm_guard.py); defaults shown ----
# per visitor per UTC day
ORALCOMPASS_LLM_LIMIT_EXTRACTION=5
# per visitor per UTC day
ORALCOMPASS_LLM_LIMIT_READER=10
# per visitor per UTC day
ORALCOMPASS_LLM_LIMIT_EXPLAINER=60
# per visitor per window
ORALCOMPASS_LLM_LIMIT_ASSISTANT=30
ORALCOMPASS_LLM_ASSISTANT_WINDOW_S=600
# any other AI feature, per visitor per UTC day
ORALCOMPASS_LLM_LIMIT_DEFAULT=20
# all visitors together, per UTC day
ORALCOMPASS_LLM_DAILY_REQUESTS=300
# estimated spend, all visitors together, per UTC day
ORALCOMPASS_LLM_DAILY_USD=2.00
# USD per 1k input tokens (Haiku 4.5: $1 per million)
ORALCOMPASS_LLM_PRICE_IN_PER_1K=0.001
# USD per 1k output tokens (Haiku 4.5: $5 per million)
ORALCOMPASS_LLM_PRICE_OUT_PER_1K=0.005

# ---- request limits (api/app/security.py) ----
# Extra routes that accept the 35 MB upload limit (comma-separated path suffixes); every route ending in /upload already does.
ORALCOMPASS_LARGE_BODY_PATHS=

# ---- web push reminders (optional; api/app/notifications.py). Without them the reminder list works and push is off. ----
VAPID_PUBLIC_KEY=
# Secret.
VAPID_PRIVATE_KEY=
# mailto: address of the operator
VAPID_SUBJECT=

# ---- paths (rarely changed) ----
# ORALCOMPASS_WEB_DIST=/app/web/dist
# ORALCOMPASS_FIXTURES_DIR=/app/fixtures

# ---- Cognito (NOT used by the single-container deployment; setting the JWKS URL switches auth from sessions to JWT) ----
# ORALCOMPASS_COGNITO_JWKS_URL=
# ORALCOMPASS_COGNITO_AUDIENCE=

# ---- platform ----
# PORT is provided by the platform (Railway sets it); the image defaults to 8000.
# Railway only: volumes mount owned by root; set RAILWAY_RUN_UID=0 so the entrypoint can hand /data to uid 10001 and then drop root.
