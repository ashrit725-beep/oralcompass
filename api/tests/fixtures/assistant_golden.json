 "rules": {
  "must_contain": "case-insensitive substrings of the simple block (the first block, kind 'simple'); '{{ref:' means an amount appears as a placeholder",
  "must_not_contain": "case-insensitive substrings that appear in no block's text (bare amounts and advice words)",
  "refs_in_simple": "when true, the simple block carries at least one ref and every {{ref:n}} resolves",
  "term": "the glossary key (api/app/assistant_glossary.py) that lookup_term returns for the message",
  "also_accept": "other intents that are also correct for a genuinely ambiguous question",
  "always": "every answer: a simple block first, at most two sentences ('simpler': one), no bare amount, advice-lint clean, demo mode"
 },
