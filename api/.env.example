# Copy to api/.env (gitignored) and fill in. The app runs fully in demo mode when no key is set:
# extraction uses the cached fixture extractor, and explanations use deterministic templates — labeled as such in the UI.
ORALCOMPASS_DEV_AUTH=1                      # dev only: X-Dev-User header is the user id. Never set in production (Cognito JWT path instead).
ORALCOMPASS_LLM_PROVIDER=openrouter         # openrouter | anthropic | none
ORALCOMPASS_LLM_MODEL=anthropic/claude-haiku-4.5   # fast model by default; any OpenRouter model id (or an Anthropic model id with provider=anthropic)
OPENROUTER_API_KEY=                         # from openrouter.ai — server-side only
ANTHROPIC_API_KEY=                          # only when ORALCOMPASS_LLM_PROVIDER=anthropic
# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`; the public key is sent to browsers, the private key never leaves the server.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
