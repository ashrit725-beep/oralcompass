{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest*)",
      "Bash(python3 tools/*)",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(npx vite*)",
      "Bash(uvicorn*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(curl*fairhealth*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-copy-on-edit.sh"
          }
        ]
      }
    ]
  }
}
