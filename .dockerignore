# Keep secrets, local data and heavy caches out of the build context.
.git
.gitignore
.claude
**/node_modules
**/dist
web/dist
web/public/fixtures
**/.vite
**/.cache
**/__pycache__
**/*.pyc
**/.pytest_cache
api/.data
api/.env
api/.env.*
**/.env
**/.env.*
.aws-sam
shots
docs
sources
infra
*.db
*.db-wal
*.db-shm
*.log
.DS_Store
